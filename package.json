{
  "name": "@kapybara/zerosub",
  "version": "1.1.0",
  "description": "ZeroSub: use several Claude and ChatGPT (Codex) subscriptions side by side in Paseo. Add accounts in-app, pick one per agent, and switch automatically when an account hits its limit.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude",
    "claude-code",
    "codex",
    "chatgpt",
    "subscriptions",
    "accounts",
    "usage-limits"
  ],
  "homepage": "https://github.com/kapybara-org/zerosub#readme",
  "bugs": {
    "url": "https://github.com/kapybara-org/zerosub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapybara-org/zerosub.git"
  },
  "license": "MIT",
  "author": "Kapybara",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "audit:mobile": "! grep -rnE \"\\\\b(document|window|localStorage|navigator)\\\\.|<(div|span|p|a|button|input|img|ul|ol|li|section|header|footer|main|nav|form|label|h[1-6]|table|tr|td|svg|path|br|hr)[ >/]|className=|onClick=\" client/"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.1",
    "@getpaseo/plugin": "0.9.1",
    "@getpaseo/protocol": "0.9.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
